DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
JWT_SECRET=dev_secret_change_me
PORT=4000

# Email side-channel for notifications (SRS F8.3). The SMTP transport is a stub,
# so "true" only logs what would have been sent — in-app notifications are the
# real delivery mechanism. See backend/src/services/email.ts.
NOTIFY_EMAIL=false

# Where QR tag PNGs are written, and the base URL encoded inside each QR code.
# Both are already read by backend/src/utils/qrGenerator.ts; these are its defaults.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:5173