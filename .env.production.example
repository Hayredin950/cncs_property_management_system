# Production environment template for the BACKEND service.
#
# Copy these keys into the backend host's environment-variable settings (Render /
# Koyeb / Fly.io — see docs/deployment.md §3). Never commit a filled-in copy:
# `.env` is gitignored at both the repo root and in `backend/`, and this file
# exists precisely so nobody needs to paste real values into a tracked file.
#
# Placeholders only. No real credential belongs in this file.

# ---- Database (Neon) -------------------------------------------------------
# Two URLs, and they are NOT interchangeable:
#   DATABASE_URL — pooled host (contains "-pooler"), used by the running app
#   DIRECT_URL   — unpooled host, used by `prisma migrate`
# prisma.config.ts reads DIRECT_URL eagerly at config load and throws if unset,
# so a missing DIRECT_URL breaks the build, not just migrations.
#
# Use a SEPARATE Neon project or branch for production. The seed script upserts
# fixed IDs and resets the demo request to PENDING — running it against
# production rewrites live rows.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXXX.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Auth ------------------------------------------------------------------
# Generate fresh: openssl rand -base64 48
# Never reuse the development value. An empty or guessable secret lets anyone
# mint a valid admin token.
JWT_SECRET=

# ---- Server ----------------------------------------------------------------
# Most hosts set PORT themselves; don't hardcode it. The health check is /health.
PORT=4000

# Comma-separated, no trailing slash. UNSET means "allow every origin", which is
# the local-dev behaviour — set this in production. See docs/deployment.md §8.
CORS_ORIGINS=

# ---- QR stickers -----------------------------------------------------------
# The FRONTEND origin. This is encoded into every printed QR sticker, so changing
# it after labels are printed dead-ends every sticker already in the field.
PUBLIC_BASE_URL=

# Where QR PNGs are written. Must be a writable path. On a host with an ephemeral
# disk the route regenerates a missing PNG on demand, so this is a cache, not
# storage. Empty = `./uploads`.
UPLOADS_DIR=./uploads

# ---- Email -----------------------------------------------------------------
# Deliberately false: services/email.ts is a stub that only logs, and there is no
# email provider account yet. In-app notifications work fully regardless.
# Setting this to true sends nothing extra today — it just logs more.
NOTIFY_EMAIL=false

# ---- Images (Cloudinary) ---------------------------------------------------
# Only needed once `POST /items/:id/photo` exists (docs/deployment.md §6b).
# Until then, photos are pasted delivery URLs and these are unused.
# Never expose API_SECRET to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
