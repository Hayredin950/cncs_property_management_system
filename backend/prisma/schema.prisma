// CNCS Property Management System — data model
//
// Phase A is being landed as an **expand → contract** migration so the app keeps
// building and the test suite keeps running at every step.
//
// Expand (this change, additive only — nothing below is removed):
//   · Department entity, with nullable department links on User and Item
//   · holder fields on Item (holder type + holder reference) beside the old ownerId
//   · the full item state machine, including PENDING_CLAIM / REVERTED_UNVERIFIED /
//     LOANED / LOST / VOIDED, plus the claim fields
//   · lifetime PIN with a database uniqueness constraint
//   · CustodyEvent — the append-only evidence log (spec 4.5)
//   · Item.version for optimistic locking, so two officers editing one item cannot
//     silently overwrite each other (gap-analysis A7)
//   · audit: session type + report number, frozen in-scope rows, uniqueness per item
//     per session, and the audit result values the review asked for
//   · account status for the approval queue
//
// Contract (next slice, with its code changes — do not do it before the code moves):
//   · drop Item.ownerId, Item.department (free text), User.department (free text)
//   · drop mustChangePassword once the admin-approval account flow is in
//
// Every add is nullable or defaulted on purpose: no backfill is required, and the
// contract migration is the one that will need the data mapping.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Spec 2.1 as amended 12 Oct: the Account Admin merged into SYSTEM_ADMIN, so five
/// roles, not six. `ADMIN`/`STAFF` are retired in the role slice; the migration maps
/// `ADMIN` → `PROPERTY_OFFICER` (the college-level operational role) and leaves
/// `STAFF` alone. See `src/services/permissions.ts` for what each role may do.
enum Role {
  SYSTEM_ADMIN
  PROPERTY_OFFICER
  DEPARTMENT_HEAD
  STAFF
  AUDITOR
}

/// Account lifecycle for the admin-approval queue (spec 3.1.2).
/// Default ACTIVE keeps every existing row and every existing test valid.
enum AccountStatus {
  ACTIVE
  PENDING_EMAIL_VERIFICATION
  PENDING_APPROVAL
  REJECTED
  DEACTIVATED
}

/// Who an item is with. Exactly one of: a staff member, a department, or the college
/// (spec 4.1). COLLEGE means the Property Office pool — holderId is null for it.
enum HolderType {
  STAFF
  DEPARTMENT
  COLLEGE
}

enum Condition {
  NEW
  GOOD
  FAIR
  DAMAGED
  BEYOND_REPAIR
}

/// Spec 4.2 states, plus LOANED, which the loan decision needs and the spec's list
/// predates. "In use vs in store" is not a state: it is derived from the holder.
enum ItemStatus {
  PENDING_CLAIM
  ACTIVE
  REVERTED_UNVERIFIED
  LOANED
  LOST
  DISPOSED
  VOIDED
}

enum RequestType {
  TRANSFER
  DISPOSAL
  /// Added for the loan workflow (plan §5).
  LOAN
  /// The role-scoped typed requests (self-use, department-use, transfer-to-department,
  /// transfer-to-individual, disposal-initiate) land with the request-model slice in
  /// Phase B, together with the narrowing of TRANSFER and DISPOSAL.
}

enum RequestStatus {
  PENDING
  PENDING_STAGE1
  PENDING_STAGE2
  APPROVED
  REJECTED
  /// Competing request on an item already promised elsewhere (plan §3).
  WAITLISTED
}

/// PENDING is the "in scope, not yet scanned" value written when a session opens,
/// which is what freezes the in-scope list (plan §6 step 2).
enum AuditItemResult {
  PENDING
  FOUND
  MISSING
  LOCATION_MISMATCH
  DAMAGED
}

enum AuditSessionType {
  ANNUAL_FULL_COUNT
  SPOT_CHECK
  COMPLIANCE
  HANDOVER
}

/// Append-only. Every claim, refusal, expiry, reversion, transfer, disposal, loss and
/// location change writes a row (spec 4.5). Rows are never updated or deleted; the
/// database role used by the app is to be denied UPDATE/DELETE on this table, which is
/// the part that makes "append-only" a mechanism rather than a policy.
enum CustodyEventType {
  CREATED
  CLAIMED
  CLAIM_REFUSED
  CLAIM_EXPIRED
  REVERTED
  TRANSFERRED
  DISPOSED
  LOST
  RECOVERED
  LOCATION_CHANGED
  VERIFIED
  HOLDER_DEACTIVATED
  EDITED
}

/// A real organisational unit. A Department is a Unit; the Office of Auditors is a unit
/// with no head (spec 2.3.2), which is why headId is optional.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// One head per department, and a head belongs to one department. A vacant head is
  /// null rather than an empty string (spec 13.1 fixes this with a fallback approver,
  /// which lands with the approver-resolution slice).
  headId String? @unique
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id])

  users User[] @relation("UserDepartment")
  items Item[] @relation("ItemDepartment")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  /// Real department link. The old system's free-text department lives on Item only
  /// and is removed in the contract slice.
  departmentId String?
  departmentRef Department? @relation("UserDepartment", fields: [departmentId], references: [id])

  /// Account lifecycle (spec 3.1.2). A self-request lands PENDING_APPROVAL and
  /// cannot sign in until a SYSTEM_ADMIN approves it — the supervisor's flagged
  /// rule: nobody self-registers into an active account. `createdAt` is the
  /// request time, so the queue needs no separate `requestedAt` column.
  accountStatus AccountStatus @default(ACTIVE)

  /// Who decided this account and when (spec 3.1.2). Null for an account an
  /// administrator created directly — there was nothing to approve — and for
  /// every row written before the queue existed.
  reviewedById String?
  reviewedBy   User?   @relation("AccountReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  /// The rejection reason, shown to the person who asked for the account.
  reviewNote   String?

  /// Bumped whenever this account's sessions must die (password change, admin
  /// reset, and role change — gap-analysis E10). Carried in the JWT as `ver`;
  /// `authenticate` rejects a token whose `ver` no longer matches. Defaults to 0,
  /// and tokens minted before this column existed carry no `ver` at all — those are
  /// trusted until they expire (≤1 day), which makes the rollout non-breaking.
  tokenVersion       Int     @default(0)
  /// Retiring with the admin-set-password flow: with self-registration the person
  /// chooses their own password (spec 3.3.7, 12.5).
  mustChangePassword Boolean @default(false)

  headOfDepartment Department? @relation("DepartmentHead")

  ownedItems       Item[]         @relation("ItemOwner")
  requestsCreated  Request[]      @relation("RequestedBy")
  requestsReviewed Request[]      @relation("ReviewedBy")
  auditsRun        AuditSession[] @relation("RunBy")
  itemEdits        ItemEditLog[]
  notifications    Notification[]
  custodyEvents    CustodyEvent[] @relation("CustodyEvents")
  voidedItems      Item[]         @relation("ItemVoidedBy")
  lastVerifiedItems Item[]        @relation("ItemLastVerifiedBy")
  /// Accounts this user approved or rejected (spec 3.1.2).
  accountsReviewed User[]         @relation("AccountReviewedBy")
  /// Transfers this user approved at stage 1 (releasing head).
  stage1ApprovedRequests Request[] @relation("TransferStage1Approvals")
  /// Transfers this user approved at stage 2 (receiving head).
  stage2ApprovedRequests Request[] @relation("TransferStage2Approvals")
  /// Items this user returned from loan.
  loansReturned Request[] @relation("LoanReturnedBy")

  /// The approval queue reads by status, oldest first.
  @@index([accountStatus])
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  items Item[]
}

model Item {
  id           String      @id @default(uuid())
  tagId        String      @unique
  /// Lifetime asset number. Unique at the database level, never reused, including
  /// after a void (the QR-tag rule in the review's item 23).
  pin          String?     @unique
  name         String
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  /// Free-text department, kept read-only until the contract slice.
  department   String
  departmentId String?
  departmentRecord Department? @relation("ItemDepartment", fields: [departmentId], references: [id])
  building     String
  floor        String
  room         String

  /// Holder model (spec 4.1). `ownerId` stays until the contract slice, because
  /// dropping it means changing every read and write at once; new code writes the
  /// holder fields. holderId is null when holderType is COLLEGE.
  holderType HolderType?
  holderId   String?

  ownerId        String
  owner          User        @relation("ItemOwner", fields: [ownerId], references: [id])
  purchaseCost   Decimal
  currentValue   Decimal?
  condition      Condition
  brand          String?
  model          String?
  serialNumber   String?
  photoUrl       String?
  notes          String?
  status         ItemStatus  @default(ACTIVE)
  disposalReason String?
  disposedAt     DateTime?
  registeredAt   DateTime    @default(now())
  lastAuditedAt  DateTime?

  /// Claim handshake (spec 4.4): the item is created PENDING_CLAIM and reverts to the
  /// college pool once claimDueAt passes. Imported items are exempt for now — that
  /// exemption is still an open question in the plan.
  claimedAt    DateTime?
  claimDueAt   DateTime?

  /// Written only by an audit (or a verification). This is the field that lets reports
  /// and the UI say "not verified since <date>" (plan §6 step 8).
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  lastVerifiedBy   User?    @relation("ItemLastVerifiedBy", fields: [lastVerifiedById], references: [id])

  /// Void replaces delete (spec 4.8). A voided row is never deleted, only hidden.
  voidReason String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?    @relation("ItemVoidedBy", fields: [voidedById], references: [id])

  /// Optimistic locking. Every write sends the version it read and fails loudly on a
  /// mismatch instead of silently overwriting another officer's edit.
  version Int @default(0)

  accessories    Item[]      @relation("ItemAccessories")
  parentItem     Item?       @relation("ItemAccessories", fields: [parentItemId], references: [id])
  parentItemId   String?

  requests       Request[]
  editLogs       ItemEditLog[]
  auditResults   AuditItemResultRow[]
  custodyEvents  CustodyEvent[]

  @@index([holderType, holderId])
  @@index([status])
  @@index([departmentId])
}

model CustodyEvent {
  id      String           @id @default(uuid())
  itemId  String
  item    Item             @relation(fields: [itemId], references: [id])
  eventType CustodyEventType

  fromHolderType HolderType?
  fromHolderId   String?
  toHolderType   HolderType?
  toHolderId     String?

  actingUserId String
  actingUser   User   @relation("CustodyEvents", fields: [actingUserId], references: [id])

  reason String?
  /// Who was the responsible department head at that moment, or "vacant" (spec 4.5,
  /// 4.9.4). Stored as identity at the time, because heads change.
  departmentHeadSnapshot String?
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
}

model Request {
  id              String        @id @default(uuid())
  type            RequestType
  status          RequestStatus @default(PENDING)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  requestedById   String
  requestedBy     User          @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reason          String
  rejectionReason String?

  newLocationBuilding String?
  newLocationFloor    String?
  newLocationRoom     String?

  /// Kept until the holder model lands in the transfer slice; new transfers record the
  /// from/to holder pair instead (plan §3).
  newOwnerId String?
  fromHolderType HolderType?
  fromHolderId   String?
  toHolderType   HolderType?
  toHolderId     String?

  /// Two-stage approval for transfers (Phase B). Stage 1 = releasing head, Stage 2 = receiving head.
  stage1ApprovedById String?
  stage1ApprovedBy   User?   @relation("TransferStage1Approvals", fields: [stage1ApprovedById], references: [id])
  stage1ApprovedAt   DateTime?
  stage2ApprovedById String?
  stage2ApprovedBy   User?   @relation("TransferStage2Approvals", fields: [stage2ApprovedById], references: [id])
  stage2ApprovedAt   DateTime?

  /// Loan fields (Phase B item 11).
  loanDueDate       DateTime?
  loanReturnedAt    DateTime?
  loanReturnedById  String?
  loanReturnedBy    User?   @relation("LoanReturnedBy", fields: [loanReturnedById], references: [id])

  createdAt DateTime  @default(now())
  decidedAt DateTime?
}

model ItemEditLog {
  id           String   @id @default(uuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  editedById   String
  editedBy     User     @relation(fields: [editedById], references: [id])
  fieldChanged String
  oldValue     String?
  newValue     String?
  editedAt     DateTime @default(now())
}

model AuditSession {
  id          String    @id @default(uuid())
  sessionType AuditSessionType @default(ANNUAL_FULL_COUNT)
  /// Serial number of the frozen report this session produces (plan §6 step 5).
  /// Official reports are reproducible artifacts, not live lists.
  reportNumber String?  @unique
  scopeType   String
  scopeValue  String?
  runById     String
  runBy       User      @relation("RunBy", fields: [runById], references: [id])
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Grace window after close before an unanswered MISSING becomes LOST (plan §6 step 4).
  graceEndsAt DateTime?

  results AuditItemResultRow[]
}

model AuditItemResultRow {
  id             String          @id @default(uuid())
  auditSessionId String
  auditSession   AuditSession    @relation(fields: [auditSessionId], references: [id])
  itemId         String
  item           Item            @relation(fields: [itemId], references: [id])
  result         AuditItemResult @default(PENDING)
  scannedAt      DateTime?

  /// One row per item per session: a duplicate row would silently double-count a
  /// department's audit (gap-analysis A5).
  @@unique([auditSessionId, itemId])
}

model Notification {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  message          String
  relatedRequestId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
}
