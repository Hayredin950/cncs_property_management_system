# Base URL of the backend API (no trailing slash, no /api/v1 — the client appends that).
VITE_API_BASE_URL=http://localhost:4000

# Public origin this app is deployed at. Only used to build the absolute URLs in
# the social preview tags (og:image, og:url) — crawlers discard a relative one.
# Optional on Vercel, which infers it from VERCEL_PROJECT_PRODUCTION_URL; set it
# when a custom domain fronts the deployment. A bare host is accepted and gets
# https:// prepended.
#
# Not needed at runtime: the /item/:tagId preview endpoint derives the origin from
# the request itself, so only the static home-page tags depend on this.
VITE_SITE_ORIGIN=http://localhost:5173
