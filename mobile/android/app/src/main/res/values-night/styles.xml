<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The night resources deliberately keep the **light** parents.

      This client has no dark theme: its first frame is a white surface (`_SplashPage`
      in lib/app/router.dart) and every screen after it is drawn on `aauGray50`. So
      inheriting `Theme.Black` here — which is what the Flutter template does — meant a
      phone in dark mode opened onto a black window and then flipped to white, with
      Android 12+ building its splash screen out of that same black colour. The window
      the app opens in is the window it keeps, in either mode.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Shown while the process starts; replaced by the Flutter engine's first
             frame. Kept as a drawable so both API levels agree. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
